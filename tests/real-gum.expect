#!/usr/bin/env expect
# Drive the real gum UI through the wizard.  The bash wrapper
# (tests/real-gum.sh) provides the environment and checks the log.
set timeout 40
log_user 0
log_file -a $env(LOG)

set scenario $env(SCENARIO)
set installer $env(INSTALLER)

spawn env \
	PATH=$env(TEST_PATH) \
	ASTRA_LIB_DIR=$env(ASTRA_LIB_DIR) \
	ASTRA_STATE_DIR=$env(ASTRA_STATE_DIR) \
	ASTRA_DRY_RUN=1 \
	ASTRA_SKIP_UEFI=1 \
	ASTRA_SKIP_TOOLS=1 \
	ASTRA_SKIP_ROOT=1 \
	bash $installer

proc fail {message} {
	puts stderr "real-gum: $message"
	exit 1
}

proc press_down {count} {
	for {set i 0} {$i < $count} {incr i} {
		send -- "\033\[B"
	}
}

# Let gum finish entering raw mode before sending.  The step header can appear
# a fraction before the input widget is ready.
proc settle {} {
	after 600
}

# Shared prefix: welcome, keyboard, package source, storage, pre-mounted layout.
expect {
	-re {Continue with the installation\?} { settle; send -- "y" }
	timeout { fail "welcome prompt not seen" }
}
expect {
	-re {Keyboard layout:} { settle; send -- "\r" }
	timeout { fail "keyboard prompt not seen" }
}
expect {
	-re {Package download source} { settle; send -- "\r" }
	timeout { fail "package source menu not seen" }
}
expect {
	-re {Storage setup} {
		settle
		press_down 3
		send -- "\r"
	}
	timeout { fail "storage menu not seen" }
}
expect {
	-re {Root mountpoint} { settle; send -- "\r" }
	timeout { fail "pre-mounted root prompt not seen" }
}
expect {
	-re {Use this pre-mounted layout\?} { settle; send -- "y" }
	timeout { fail "pre-mounted confirmation not seen" }
}

if {$scenario eq "back"} {
	# Ctrl-C at hostname should return to storage, not close the terminal.
	expect {
		-re {Hostname:} { settle; send -- "\003" }
		timeout { fail "hostname prompt not seen" }
	}
	expect {
		-re {Storage setup} { settle; send -- "\033" }
		timeout { fail "did not return to the storage menu" }
	}
	expect {
		-re {Package download source} { settle; send -- "\033" }
		timeout { fail "did not return to the package source menu" }
	}
	expect {
		-re {Keyboard layout:} { settle; send -- "\033" }
		timeout { fail "did not return to the keyboard step" }
	}
	expect {
		-re {Continue with the installation\?} { settle; send -- "n" }
		timeout { fail "did not return to the welcome screen" }
	}
	expect {
		-re {Exit the installer\?} { settle; send -- "y" }
		timeout { fail "exit confirmation not seen" }
	}
	catch wait result
	set rc [lindex $result 3]
	if {$rc != 0} {
		fail "back-navigation run exited with $rc"
	}
	exit 0
}

expect {
	-re {Hostname:} { settle; send -- "\r" }
	timeout { fail "hostname prompt not seen" }
}
expect {
	-re {Root password:} { settle; send -- "rootpass\r" }
	timeout { fail "root password prompt not seen" }
}
expect {
	-re {Confirm root password:} { settle; send -- "rootpass\r" }
	timeout { fail "root password confirmation not seen" }
}
expect {
	-re {Username:} { settle; send -- "user\r" }
	timeout { fail "username prompt not seen" }
}
expect {
	-re {Password for user:} { settle; send -- "userpass\r" }
	timeout { fail "user password prompt not seen" }
}
expect {
	-re {Confirm password for user:} { settle; send -- "userpass\r" }
	timeout { fail "user password confirmation not seen" }
}
expect {
	-re {Sudo access for user} { settle; send -- "\r" }
	timeout { fail "sudo menu not seen" }
}
expect {
	-re {Timezone:} { settle; send -- "\r" }
	timeout { fail "timezone prompt not seen" }
}
expect {
	-re {Locale} { settle; send -- "\r" }
	timeout { fail "locale menu not seen" }
}
expect {
	-re {Extra packages \(optional\):} { settle; send -- "\r" }
	timeout { fail "extra packages prompt not seen" }
}
expect {
	-re {Type INSTALL to begin:} { settle; send -- "INSTALL\r" }
	timeout { fail "INSTALL prompt not seen" }
}
expect {
	-re {Start the installation now\?} { settle; send -- "y" }
	timeout { fail "final confirmation not seen" }
}
expect {
	-re {Dry run complete} { }
	timeout { fail "dry-run completion screen not seen" }
}
catch wait result
set rc [lindex $result 3]
if {$rc != 0} {
	fail "successful run exited with $rc"
}
exit 0
