	'opencode'
	'fastfetch'
	'btop'
	'adwaita-fonts'
	'adw-gtk-theme'
	'papirus-icon-theme'
	'ttf-jetbrains-mono-nerd'
	'dconf'
	'glib2'
	'xdg-user-dirs'
	'xdg-utils'
	'gnome-keyring'
	'polkit'
	'networkmanager'
	'bluez'
	'bluez-utils'
	'power-profiles-daemon'
	'upower'
	'pipewire'
	'wireplumber'
	'wl-clipboard'
	'brightnessctl'
	'playerctl'
	'grim'
	'slurp'
	'nautilus'
	'firefox'
	'mpv'
	'loupe'
	'papers'
