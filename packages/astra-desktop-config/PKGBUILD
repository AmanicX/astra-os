# Maintainer: AstraOS <build@astraos.org>
# Description: Seeded, sanitized desktop configuration for the AstraOS niri + Noctalia session.
pkgname=astra-desktop-config
pkgver=0.1.0
pkgrel=3
pkgdesc="Seeded niri, Noctalia, kitty, Zsh, Neovim and XDG desktop defaults for AstraOS"
arch=('x86_64')
license=('MIT')
depends=(
