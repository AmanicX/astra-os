{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/usr/share/astra/branding/astraos-logo.png",
    "type": "auto",
    "width": 28,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#e6b450",
      "title": "#aad94c",
      "output": "#d1d1c7"
    },
    "percent": {
      "color": {
        "green": "#39bae6",
        "yellow": "#efcf8f",
        "red": "#d95757"
      }
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "break",
    "colors"
  ]
}
