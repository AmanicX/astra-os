# Maintainer: AstraOS <build@astraos.org>
# Description: SilentSDDM with AstraOS presets, wallpapers and a switcher.
#
# Upstream is pinned to a tested commit. Only the GPL theme code and assets
# needed by the greeter are installed; upstream demo videos, previews and
# unrelated backgrounds are removed. See THIRD_PARTY.md.
pkgname=astra-sddm-theme
pkgver=0.3.0
pkgrel=1
pkgdesc="SilentSDDM theme with AstraOS wallpapers and a preset switcher"
arch=('any')
license=('GPL-3.0-or-later')
depends=(
	'sddm>=0.21.0'
	'qt6-5compat'
	'qt6-declarative'
	'qt6-imageformats'
	'qt6-multimedia-ffmpeg'
	'qt6-svg'
	'qt6-virtualkeyboard'
	'adwaita-fonts'
	'astra-branding'
)
makedepends=('git')
source=("silent-sddm::git+https://github.com/uiriansan/SilentSDDM.git#commit=d477613b07ca13729af20cb4699b308ac7348d2f")
sha256sums=('SKIP')

prepare() {
	cd "${srcdir}/silent-sddm"

	# Keep the theme code, components, icons and QML metadata. Remove upstream
	# demo media, previews, install helpers and Nix packaging that are not part
	# of the installed greeter.
	rm -rf .git .github nix docs install.sh test.sh change_avatar.sh
	find backgrounds -mindepth 1 -maxdepth 1 -delete
	rm -f configs/*.conf

	# The greeter is configured through our presets and /etc/sddm.conf.d.
	sed -i \
		-e 's|^Name=.*|Name=AstraOS Silent|' \
		-e 's|^Description=.*|Description=AstraOS SilentSDDM theme|' \
		-e 's|^Screenshot=.*||' \
		-e 's|^ConfigFile=.*|ConfigFile=configs/astra-orbital.conf|' \
		metadata.desktop
}

package() {
	install -d "${pkgdir}/usr/share/sddm/themes/silent"
	cp -a "${srcdir}/silent-sddm/." \
		"${pkgdir}/usr/share/sddm/themes/silent/"

	local theme="${pkgdir}/usr/share/sddm/themes/silent"
	install -d "${theme}/configs" "${theme}/backgrounds"
	install -m0644 "${startdir}"/presets/astra-*.conf "${theme}/configs/"

	# Absolute symlinks keep the greeter package independent of the branding
	# package version while still resolving to the installed wallpaper set.
	ln -s /usr/share/backgrounds/astraos/astraos-default.png \
		"${theme}/backgrounds/astraos-default.png"
	for name in aurora ember lunar; do
		ln -s "/usr/share/backgrounds/astraos/astraos-${name}.png" \
			"${theme}/backgrounds/astraos-${name}.png"
	done
	ln -s /usr/share/backgrounds/astraos/astraos-earthrise.jpg \
		"${theme}/backgrounds/astraos-earthrise.jpg"
	ln -s /usr/share/backgrounds/astraos/astraos-carina.png \
		"${theme}/backgrounds/astraos-carina.png"
	ln -s /usr/share/backgrounds/astraos/astraos-deepfield.jpg \
		"${theme}/backgrounds/astraos-deepfield.jpg"

	install -Dm644 "${startdir}/astra.conf" \
		"${pkgdir}/etc/sddm.conf.d/astra.conf"
	install -Dm755 "${startdir}/astra-sddm-theme" \
		"${pkgdir}/usr/bin/astra-sddm-theme"
}
