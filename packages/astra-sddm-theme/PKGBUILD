# Maintainer: AstraOS <build@astraos.org>
# Description: Astronaut SDDM theme, pinned upstream code with AstraOS artwork.
#
# Owner decision D-009 was superseded on 2026-10-20: the Noctalia SDDM theme
# rendered incorrectly on the live ISO, so the owner requested the astronaut
# theme. Only upstream code is shipped. The unrelated background images, the
# preview screenshots and the bundled fonts are removed; the AstraOS wallpaper
# replaces them. See THIRD_PARTY.md.
pkgname=astra-sddm-theme
pkgver=0.2.0
pkgrel=1
pkgdesc="Astronaut SDDM theme with AstraOS artwork"
arch=('any')
license=('GPL-3.0-or-later')
depends=(
	'sddm'
	'qt6-5compat'
	'qt6-declarative'
	'qt6-multimedia-ffmpeg'
	'qt6-svg'
	'qt6-virtualkeyboard'
	'adwaita-fonts'
	'astra-branding'
)
makedepends=('git')
source=("sddm-astronaut-theme::git+https://github.com/Keyitdev/sddm-astronaut-theme.git#commit=abb3163c724935af888ba5ea9ac0c4f22afd8048")
sha256sums=('SKIP')

prepare() {
	cd "${srcdir}/sddm-astronaut-theme"

	# Keep the GPL theme code and its icon assets. Remove the unrelated
	# wallpapers, previews, install helper and bundled fonts whose provenance
	# is not documented upstream.
	rm -rf .git .github Previews Fonts setup.sh
	find Backgrounds -mindepth 1 -maxdepth 1 -exec rm -rf {} +
	find Themes -mindepth 1 -maxdepth 1 -type f ! -name 'astronaut.conf' -delete

	# Use the original AstraOS wallpaper and a font the image ships.
	ln -s /usr/share/backgrounds/astraos/astraos-default.png \
		Backgrounds/astraos-default.png
	sed -i \
		-e 's|^Background=.*|Background="Backgrounds/astraos-default.png"|' \
		-e 's|^Font=.*|Font="Adwaita Sans"|' \
		Themes/astronaut.conf

	# Select the astronaut variant and drop the missing preview reference.
	sed -i \
		-e 's|^Name=.*|Name=AstraOS Astronaut|' \
		-e 's|^Description=.*|Description=AstraOS Astronaut SDDM theme|' \
		-e 's|^ConfigFile=.*|ConfigFile=Themes/astronaut.conf|' \
		-e '/^Screenshot=/d' \
		metadata.desktop
}

package() {
	install -d "${pkgdir}/usr/share/sddm/themes/sddm-astronaut-theme"
	cp -a "${srcdir}/sddm-astronaut-theme/." \
		"${pkgdir}/usr/share/sddm/themes/sddm-astronaut-theme/"

	install -Dm644 "${startdir}/astra.conf" \
		"${pkgdir}/etc/sddm.conf.d/astra.conf"
}
