#!/usr/bin/env bash
# Generate the keybind overlay data and start the Quickshell instance.
set -Eeuo pipefail

readonly GENERATOR="/usr/share/astra/keybinds/gen-keybinds.py"

[[ -r ${GENERATOR} ]] || {
	printf 'astra-keybinds-start: missing %s\n' "$GENERATOR" >&2
	exit 1
}

python3 "$GENERATOR"
exec qs -c keybinds -d
