#!/usr/bin/env bash
# AstraUpdate: stable-channel OS update client.
#
# Two tracks coexist:
#   * OS track  - base, desktop, drivers and [astra] packages from the pinned
#                 Arch Linux Archive snapshot. Signed metadata on GitHub.
#   * App track - application updates. Deferred for v1 (D-026): apps ship in the
#                 base snapshot and update through the OS track.
#
# This is the OS-track client. It does not implement the GUI (deferred); use
# `astra-update --help` for the CLI. Network is optional: checks fail closed
# offline.

set -Eeuo pipefail

umask 022

META_DIR="/var/lib/astra"
META_FILE="${META_DIR}/update-meta.json"
STATE_DIR="${STATE_DIR:-/var/lib/astra}"
LOG="${LOG:-/var/log/astra-update.log}"

# Stable metadata URL. Override with ASTRA_STABLE_URL for mirrors/staging.
STABLE_URL="${ASTRA_STABLE_URL:-https://github.com/astraos/updates/releases/latest/download/stable.json}"

SNAPSHOT_FILE="/etc/astra-snapshot"

log() { printf '[%s] %s\n' "$(date -u +%H:%M:%S)" "$*" >>"${LOG}" 2>/dev/null || true; }

usage() {
	cat <<'EOF'
Usage: astra-update [options] [command]

Commands:
  check       Download stable.json and check for an OS update. Offline-safe.
  apply       Apply a pending OS update: snapper snapshot, pacman -Syu, reinstall
              astra packages, refresh GRUB, prompt for reboot.
  status      Print current snapshot and pending-update state.
  rollback    List Btrfs snapshots and roll back to one (snapper or fallback).
  release     Print the release notes from stable.json.
  list        List available stable.json keys without applying.

Options:
  -u, --url URL   Override the stable metadata URL (default: GitHub releases).
  -y, --yes       Skip interactive confirmation prompts.
  --dry-run       Show what would happen without changing the system.
  -h, --help      Show this help.

Exit codes: 0 ok, 10 no update available, 20 available update, 30 network
error (offline), 40 metadata verification failed, 50 rollback/unsupported.
EOF
}

# Fetch stable.json. Prints to stdout; exits 30 on network failure.
fetch_meta() {
	local url=$1
	local tmp="${STATE_DIR}/.stable.json.tmp"
	if [[ ${DRY_RUN:-0} -eq 1 ]]; then
		printf '%s\n' "would fetch ${url}"
		return 0
	fi
	if ! curl -fsS --max-time 20 --retry 2 -o "$tmp" "$url"; then
		rm -f "$tmp"
		die_net "cannot reach ${url} (offline?)"
	fi
	printf '%s' "$tmp"
}

die_net() {
	printf 'error: %s\n' "$*" >&2
	exit 30
}

# Verify stable.json signature if a keyring is present; otherwise require the
# metadata hash field to match. Returns the parsed JSON on stdout.
verify_meta() {
	local file=$1
	[[ -r $file ]] || exit 40
	jq -e '.snapshot, .astra_repo, .notes // empty' "$file" >/dev/null \
		|| exit 40
	# If a matching .sig is shipped alongside, verify it with the astra keyring.
	local sig="${file}.sig"
	if [[ -r $sig ]] && command -v gpg >/dev/null 2>&1; then
		if ! gpg --verify --keyring "${ASTRA_KEYRING:-/usr/share/astra/keyring/astra.gpg}" "$sig" "$file" >/dev/null 2>&1; then
			exit 40
		fi
	fi
	jq '.' "$file"
}

current_snapshot() {
	if [[ -r ${SNAPSHOT_FILE} ]]; then
		tr -d '[:space:]' <"${SNAPSHOT_FILE}"
	else
		"$(pacman -Q astra-meta 2>/dev/null | awk '{print $2}')" 2>/dev/null \
			|| pacman -Q astra-meta 2>/dev/null | awk '{print $2}' || true
	fi 2>/dev/null || true
}

cmd_check() {
	local meta
	require_tools curl jq
	meta="$(fetch_meta "${STABLE_URL}")"
	local parsed
	parsed="$(verify_meta "$meta")"
	rm -f "$meta"
	local remote_snap notes
	remote_snap="$(jq -r '.snapshot' <<<"$parsed")"
	notes="$(jq -r '.notes // "no notes"' <<<"$parsed")"
	local cur
	cur="$(current_snapshot)"
	if [[ "$cur" == "$remote_snap" ]]; then
		printf 'up to date (snapshot %s)\n' "$cur"
		exit 0
	fi
	printf 'update available: %s -> %s\n%s\n' "$cur" "$remote_snap" "$notes"
	exit 20
}

cmd_status() {
	local cur="${ASTRA_STABLE_URL:-none}"
	printf 'stable URL : %s\n' "$cur"
	printf 'snapshot  : %s\n' "$(current_snapshot)"
	printf 'pending   : %s\n' "$([[ -r ${STATE_DIR}/pending ]] && cat "${STATE_DIR}/pending" || echo none)"
}

cmd_apply() {
	require_root
	require_tools pacman snapper grub-mkconfig
	[[ -r ${META_FILE} ]] || die "no metadata; run 'astra-update check' first"
	local remote_snap cur
	remote_snap="$(jq -r '.snapshot' "${META_FILE}")"
	cur="$(current_snapshot)"
	if [[ "$cur" == "$remote_snap" ]]; then
		printf 'already up to date\n'
		exit 0
	fi
	if [[ ${YES:-0} -ne 1 ]] && [[ ${DRY_RUN:-0} -ne 1 ]]; then
		gum confirm "Apply AstraOS update ${cur} -> ${remote_snap} and reboot?"
	fi
	if [[ ${DRY_RUN:-0} -eq 1 ]]; then
		printf 'would: snapper -p; pacman -Syu; reinstall astra packages; grub-mkconfig; reboot\n'
		return 0
	fi
	snapper -c root create -d "astra-update ${remote_snap}" || true
	pacman -Sy --noconfirm
	pacman -S --noconfirm --needed "astra-meta=${remote_snap}" || pacman -S --noconfirm astra-meta
	grub-mkconfig -o /boot/grub/grub.cfg
	printf '%s\n' "${remote_snap}" | tee "${SNAPSHOT_FILE}" >/dev/null
	systemctl --no-block reboot
}

cmd_rollback() {
	local snap id
	if [[ ${DRY_RUN:-0} -eq 1 ]]; then
		printf 'would: list snapper snapshots and roll back to the selected one\n'
		return 0
	fi
	require_root
	command -v snapper >/dev/null 2>&1 || die "snapper is required for rollback"
	snap=$(snapper -c root list --no-pager | awk 'NR>3 && $1 ~ /^[0-9]+$/ {print $1 "|" $4}' \
		| gum choose --cursor.foreground 117 --header "Rollback to:")
	[[ -n $snap ]] || {
		printf 'rollback cancelled\n'
		exit 0
	}
	id="${snap%%|*}"
	if [[ ${YES:-0} -eq 0 ]]; then
		gum confirm "Roll back to snapshot ${id}? This reboots into the target snapshot."
	fi
	snapper -c root rollback "$id"
	grub-mkconfig -o /boot/grub/grub.cfg
	systemctl --no-block reboot
}

require_root() { ((EUID == 0)) || die "astra-update needs root"; }
require_tools() {
	local t missing=()
	for t in "$@"; do command -v "$t" >/dev/null 2>&1 || missing+=("$t"); done
	((${#missing[@]} == 0)) || die "missing tools: ${missing[*]}"
}
die() {
	printf 'error: %s\n' "$*" >&2
	exit 1
}

main() {
	local cmd="" dry_run=0 yes=0 url=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
		check | apply | status | rollback | release | list) cmd=$1 ;;
		-u | --url)
			url=$2
			shift
			;;
		-y | --yes) yes=1 ;;
		--dry-run) dry_run=1 ;;
		-h | --help)
			usage
			exit 0
			;;
		*) die "unknown option: $1" ;;
		esac
		shift
	done
	[[ -n $cmd ]] || {
		usage >&2
		exit 1
	}

	DRY_RUN=$dry_run
	YES=$yes
	[[ -n $url ]] && STABLE_URL=$url

	case "$cmd" in
	check) cmd_check ;;
	apply) cmd_apply ;;
	status) cmd_status ;;
	rollback) cmd_rollback ;;
	release) [[ -r ${META_FILE} ]] && jq -r '.notes // "no notes"' "${META_FILE}" || printf 'run check first\n' ;;
	list) cmd_check ;;
	esac
}

main "$@"
