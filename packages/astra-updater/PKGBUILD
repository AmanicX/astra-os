# Maintainer: AstraOS <build@astraos.org>
# Description: Stable-channel OS update client (CLI). GUI deferred (D-026).
pkgname=astra-updater
pkgver=0.1.0
pkgrel=1
pkgdesc="AstraUpdate stable-channel OS update client (CLI)"
arch=('x86_64')
license=('MIT')
depends=('bash' 'curl' 'gnupg' 'jq' 'snapper' 'grub')
optdepends=('gum: interactive confirmation prompts')
install=astra-updater.install
options=(!strip)

package() {
	install -Dm755 "${startdir}/astra-updater" "${pkgdir}/usr/bin/astra-update"

	install -d "${pkgdir}/usr/share/astra/manifests"
	install -Dm644 "${startdir}/stable.example.json" \
		"${pkgdir}/usr/share/astra/stable.example.json"
	install -Dm644 "${startdir}/astra-update.service" \
		"${pkgdir}/usr/lib/systemd/system/astra-update.service"
	install -Dm644 "${startdir}/astra-update.timer" \
		"${pkgdir}/usr/lib/systemd/system/astra-update.timer"

	install -d -m 0755 "${pkgdir}/etc"
	install -Dm644 "${startdir}/snapshot" \
		"${pkgdir}/etc/astra-snapshot"
}
