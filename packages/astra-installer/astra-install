#!/usr/bin/env python3
"""
AstraOS Terminal Installer CLI Wrapper.
Launches the 17-screen Textual wizard.
"""

import sys
from pathlib import Path

# Add package directory to path if running locally or from /usr/lib/astra/installer
current_dir = Path(__file__).resolve().parent
if (current_dir / "astra_installer").is_dir():
    sys.path.insert(0, str(current_dir))

lib_dir = Path("/usr/lib/astra/installer")
if lib_dir.is_dir():
    sys.path.insert(0, str(lib_dir))

from astra_installer.cli import main

if __name__ == "__main__":
    main()
