#!/usr/bin/env bash
# AstraOS installer entry point.
#
# Interactive flow, archinstall-style:
#   keyboard -> package source -> storage -> hostname -> passwords -> user
#   -> timezone/locale -> extras -> review -> install
#
# There is deliberately no `set -e` here.  gum returns non-zero on Esc, and
# optional probes (blkid, lspci, findmnt) return non-zero routinely.  Fatal
# errors go through `die`, which keeps the terminal open and prints the log.

set -uo pipefail
umask 022

DRY_RUN=${ASTRA_DRY_RUN:-0}
INSTALLER_LIB_DIR="${ASTRA_LIB_DIR:-/usr/lib/astra/installer}"

# shellcheck source=lib/common.sh
source "${INSTALLER_LIB_DIR}/lib/common.sh"
# shellcheck source=lib/hw.sh
source "${INSTALLER_LIB_DIR}/lib/hw.sh"
# shellcheck source=lib/mirrors.sh
source "${INSTALLER_LIB_DIR}/lib/mirrors.sh"
# shellcheck source=lib/storage.sh
source "${INSTALLER_LIB_DIR}/lib/storage.sh"
# shellcheck source=lib/install.sh
source "${INSTALLER_LIB_DIR}/lib/install.sh"

trap 'on_exit' EXIT
trap 'abort_user' INT TERM

welcome() {
	while true; do
		clear
		gum style --foreground 117 --align center --width 66 --margin 1 \
			"AstraOS installer" \
			"UEFI • AstraOS • $(astra_version)" 2>/dev/null || true
		ui_markdown '## Before we start

- This is a **UEFI-only** installer.
- The install downloads packages from the Arch Linux Archive or a mirror, so
  the live session needs an internet connection.
- **Back up your data.** No installer can recover a disk that was erased.
- Nothing is written to a partition table until the final `INSTALL`
  confirmation. The one exception is `cfdisk`: when you choose free-space or
  manual storage, you edit the table yourself and the installer reads it.

Press `Esc` on a later screen to go back to the previous step. The installer
does not close silently.' || die "could not show the welcome screen"

		if ui_confirm "Continue with the installation?"; then
			return 0
		fi
		# Esc or "No" on the first screen is the one place where an exit is
		# reasonable, but it still needs an explicit second confirmation.
		if ui_confirm "Exit the installer?"; then
			log "user chose to exit at the welcome screen"
			return 1
		fi
	done
}

ask_keyboard() {
	step_header "Keyboard layout"
	local choice keymaps=()

	if command -v localectl >/dev/null 2>&1; then
		mapfile -t keymaps < <(localectl list-keymaps 2>/dev/null | sort -u)
	fi

	while true; do
		if ((${#keymaps[@]} > 0)); then
			choice="$(printf '%s\n' "${keymaps[@]}" |
				ui_filter "Keyboard layout" "Type to search, e.g. us, uk, de")" ||
				return 1
		else
			choice="$(ui_input "Keyboard layout" "us" "${STATE[kb_layout]}")" ||
				return 1
		fi
		[[ -n ${choice:-} ]] && break
		warn "no keyboard layout selected"
	done

	if command -v loadkeys >/dev/null 2>&1; then
		loadkeys "$choice" 2>/dev/null || warn "could not activate keymap ${choice} in this session"
	fi
	STATE[kb_layout]="$choice"
	log "keyboard layout: ${choice}"
	return 0
}

ask_hostname() {
	step_header "Hostname"
	local host
	while true; do
		host="$(ui_input "Hostname" "astraos" "${STATE[hostname]}")" ||
			return 1
		host="${host//[[:space:]]/}"
		if validate_hostname "$host"; then
			STATE[hostname]="$host"
			log "hostname: ${host}"
			return 0
		fi
		ui_markdown 'Invalid hostname. Use 1–63 letters, digits or hyphens; it must start and end with a letter or digit.' || true
	done
}

ask_root_password() {
	step_header "Root password"
	local first second
	while true; do
		first="$(ui_password "Root password")" || return 1
		if ! validate_password "$first"; then
			ui_markdown 'The root password cannot be empty or contain a newline.' || true
			continue
		fi
		second="$(ui_password "Confirm root password")" || return 1
		if [[ $first != "$second" ]]; then
			warn "root passwords do not match"
			continue
		fi
		STATE[root_password]="$first"
		log "root password set"
		return 0
	done
}

ask_user() {
	step_header "User account"
	local user first second sudo_mode
	while true; do
		user="$(ui_input "Username" "user" "${STATE[user_name]}")" ||
			return 1
		user="${user//[[:space:]]/}"
		if validate_username "$user"; then
			STATE[user_name]="$user"
			break
		fi
		ui_markdown 'Invalid username. Use lowercase letters, digits, `_` or `-`; it must start with a letter or `_`, and cannot be `root`.' || true
	done

	while true; do
		first="$(ui_password "Password for ${user}")" || return 1
		if ! validate_password "$first"; then
			ui_markdown 'The password cannot be empty or contain a newline.' || true
			continue
		fi
		second="$(ui_password "Confirm password for ${user}")" ||
			return 1
		if [[ $first != "$second" ]]; then
			warn "user passwords do not match"
			continue
		fi
		STATE[user_password]="$first"
		break
	done

	sudo_mode="$(ui_choose "Sudo access for ${user}" \
		"Passwordless sudo (recommended)" \
		"Require the user password for sudo" \
		"No sudo access")" || return 1
	case "$sudo_mode" in
	Passwordless*) STATE[user_sudo]="passwordless" ;;
	Require*) STATE[user_sudo]="with-password" ;;
	No*) STATE[user_sudo]="none" ;;
	*) return 1 ;;
	esac
	log "user: ${user} (sudo: ${STATE[user_sudo]})"
	return 0
}

ask_timezone_locale() {
	step_header "Timezone and locale"
	local tz loc zones=()

	if command -v timedatectl >/dev/null 2>&1; then
		mapfile -t zones < <(timedatectl list-timezones 2>/dev/null | sort -u)
	fi
	while true; do
		if ((${#zones[@]} > 0)); then
			tz="$(printf '%s\n' "${zones[@]}" |
				ui_filter "Timezone" "Type to search, e.g. Europe/Berlin")" ||
				return 1
		else
			tz="$(ui_input "Timezone" "UTC" "${STATE[timezone]}")" ||
				return 1
		fi
		if validate_timezone "${tz:-}"; then
			break
		fi
		ui_markdown "Invalid timezone \`${tz:-}\`. Use an IANA name such as \`UTC\` or \`Europe/Berlin\`." || true
	done
	STATE[timezone]="$tz"

	while true; do
		loc="$(ui_choose "Locale" \
			"en_US.UTF-8" "en_GB.UTF-8" "de_DE.UTF-8" "fr_FR.UTF-8" \
			"es_ES.UTF-8" "it_IT.UTF-8" "pt_BR.UTF-8" "ru_RU.UTF-8" \
			"ja_JP.UTF-8" "zh_CN.UTF-8" "C.UTF-8" \
			"Other (type manually)")" || return 1
		if [[ $loc == Other* ]]; then
			loc="$(ui_input "Locale" "en_US.UTF-8" "${STATE[locale]}")" ||
				return 1
		fi
		if validate_locale "${loc:-}"; then
			break
		fi
		ui_markdown "Invalid locale \`${loc:-}\`. Use a UTF-8 locale such as \`en_US.UTF-8\`." || true
	done
	STATE[locale]="$loc"
	log "timezone: ${tz}; locale: ${loc}"
	return 0
}

ask_extra_packages() {
	step_header "Extra packages"
	ui_markdown 'Optionally enter extra packages from the Arch repositories,
separated by commas. Leave empty to install only the AstraOS set.

Example: `steam, gimp, libreoffice-fresh`' || true
	local extra
	extra="$(ui_input "Extra packages (optional)" "steam, gimp")" ||
		return 1
	STATE[extra_packages]="$extra"
	log "extra packages: ${extra:-none}"
	return 0
}

summary() {
	step_header "Review"
	local storage
	storage="$(storage_summary)"
	local extras=${STATE[extra_packages]:-none}
	[[ -n $extras ]] || extras="none"
	local source_label snap=""
	if [[ ${STATE[mirror_source]} == "ala" ]]; then
		if [[ -r ${SNAPSHOT_FILE:-} ]]; then
			snap="$(tr -d '[:space:]' <"${SNAPSHOT_FILE}")"
		fi
		source_label="Arch Linux Archive (pinned ${snap:-snapshot})"
	else
		source_label="Arch mirrors (${STATE[mirror_region]})"
	fi

	while true; do
		ui_markdown "## Installation summary

- **Keyboard:** \`${STATE[kb_layout]}\`
- **Package source:** ${source_label}
- **Hostname:** \`${STATE[hostname]}\`
- **User:** \`${STATE[user_name]}\` (sudo: ${STATE[user_sudo]})
- **Timezone:** \`${STATE[timezone]}\`
- **Locale:** \`${STATE[locale]}\`
- **Extra packages:** \`${extras}\`

### Storage

${storage}

Type **INSTALL** to continue. After this point the installer will write to the
selected disk." || die "could not show the summary"

		local answer
		answer="$(ui_input "Type INSTALL to begin" "INSTALL")" || return 1
		if [[ $answer != "INSTALL" ]]; then
			warn "installation was not confirmed; type INSTALL exactly"
			continue
		fi
		ui_confirm "Start the installation now?" || return 1
		log "final confirmation accepted: storage_mode=${STATE[storage_mode]} disk=${STATE[disk]} root=${STATE[root_part]} esp=${STATE[esp_part]}"
		return 0
	done
}

show_complete() {
	clear
	gum style --foreground 117 --align center --width 66 --margin 1 \
		"AstraOS installer" "Installation complete" 2>/dev/null || true
	local extra=""
	if [[ ${STATE[storage_mode]} == premounted ]]; then
		extra="

Your pre-mounted filesystems are **still mounted** at \`${STATE[premounted_root]}\`.
Reboot or unmount them yourself when you are ready."
	fi
	ui_markdown "## AstraOS is installed

Remove the installation USB and reboot into the new system.

The installer log is at \`/var/log/astra-install.log\` on the new system.
${extra}" || true

	if ui_confirm "Reboot now?"; then
		cleanup_mounts
		sync
		reboot || {
			warn "reboot failed; reboot manually"
			pause
		}
	else
		pause
	fi
}

main() {
	require_root
	init_runtime "$@"
	require_tools \
		gum jq lsblk findmnt mountpoint blkid partprobe udevadm \
		sgdisk parted cfdisk pacstrap arch-chroot genfstab \
		mkfs.fat mkfs.btrfs btrfs localectl timedatectl \
		blockdev sha256sum dd
	check_uefi

	welcome || {
		log "installer exited before changing anything"
		exit 0
	}

	# A small step machine rather than a straight line.  Every ask_* function
	# returns 1 when the user presses Esc / chooses No; that moves one step back
	# instead of tearing down the terminal.  The only exit without a completed
	# install is the confirmed exit on the welcome screen above.
	local step=1 rc=0
	while true; do
		CURRENT_STEP=$step
		case $step in
		1)
			ask_keyboard
			rc=$?
			;;
		2)
			ask_package_source
			rc=$?
			;;
		3)
			ask_storage
			rc=$?
			;;
		4)
			ask_hostname
			rc=$?
			;;
		5)
			ask_root_password
			rc=$?
			;;
		6)
			ask_user
			rc=$?
			;;
		7)
			ask_timezone_locale
			rc=$?
			;;
		8)
			ask_extra_packages
			rc=$?
			;;
		9)
			summary
			rc=$?
			;;
		*) die "internal error: unknown wizard step ${step}" ;;
		esac

		if ((rc != 0)); then
			step=$((step - 1))
			if ((step < 1)); then
				welcome || {
					log "installer exited at the welcome screen"
					exit 0
				}
				step=1
			fi
			continue
		fi
		((step == 9)) && break
		step=$((step + 1))
	done

	dump_answers
	if ((DRY_RUN == 1)); then
		log "dry run complete; no storage or installation action taken"
		ui_markdown '## Dry run complete

All answers were collected and the storage plan was reviewed. **No partition,
filesystem, mount, package, or bootloader change was made.**' || true
		return 0
	fi

	WIZARD_ACTIVE=0
	run_install
	show_complete
}

main "$@"
