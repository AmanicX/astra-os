# Maintainer: AstraOS <build@astraos.org>
# Description: AstraOS modern terminal installer powered by Textual and Archinstall.
# ISO-only; not a dependency of astra-meta.
pkgname=astra-installer
pkgver=1.0.0
pkgrel=1
pkgdesc="AstraOS modern terminal installer powered by Textual and Archinstall"
arch=('any')
license=('GPL-3.0-only')
depends=(
	'python' 'python-textual' 'archinstall' 'kitty' 'bash' 'parted'
	'gptfdisk' 'jq' 'pciutils' 'usbutils' 'arch-install-scripts'
	'btrfs-progs' 'dosfstools' 'util-linux' 'kbd' 'networkmanager'
	'os-prober' 'ntfs-3g'
)
install=astra-installer.install
options=(!strip)

package() {
	install -d "${pkgdir}/usr/lib/astra/installer"
	install -Dm755 "${startdir}/astra-install" \
		"${pkgdir}/usr/bin/astra-install"

	# Install Python package module
	cp -a "${startdir}/astra_installer" "${pkgdir}/usr/lib/astra/installer/"

	install -Dm644 "${startdir}/astra-installer.desktop" \
		"${pkgdir}/usr/share/applications/astra-installer.desktop"

	# systemd first-boot units.
	install -Dm644 "${startdir}/astra-pending-packages.service" \
		"${pkgdir}/usr/lib/systemd/system/astra-pending-packages.service"
	install -Dm755 "${startdir}/astra-pending-packages.sh" \
		"${pkgdir}/usr/lib/astra/installer/pending-packages.sh"
}
